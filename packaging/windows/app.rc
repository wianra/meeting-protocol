#include <winver.h>
#include "version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_COMMAS
PRODUCTVERSION VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Raphael Winkler"
      VALUE "FileDescription", "Meeting Protocol"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "LegalCopyright", "(c) 2026 Raphael Winkler. MIT licence."
      VALUE "OriginalFilename", "Meeting Protocol.exe"
      VALUE "ProductName", "Meeting Protocol"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
